# 从仓库根目录运行 `uv run nextcoder ...` 时会读取同目录的 .env。
# 主入口必填；没有这两项，doctor/run 会直接报配置错误。
NEXTCODER_LLM_BASE_URL=
NEXTCODER_LLM_MODEL=
NEXTCODER_LLM_API_KEY=
# 可选：三项都填才启用主入口 429 时的备援。
NEXTCODER_LLM_FALLBACK_BASE_URL=
NEXTCODER_LLM_FALLBACK_MODEL=
NEXTCODER_LLM_FALLBACK_API_KEY=
# disabled / enabled / omit；不兼容 thinking 的入口保持 disabled。
NEXTCODER_LLM_THINKING=disabled
